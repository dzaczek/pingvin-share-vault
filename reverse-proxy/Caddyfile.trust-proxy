# Used when TRUST_PROXY=true. X-Forwarded-For is only taken from senders in
# TRUST_PROXY_FROM, by default the private networks a reverse proxy usually
# sits in. Anyone else could otherwise write any address into the access log.
# List the proxy right in front of this container, separated by spaces, for
# example TRUST_PROXY_FROM=10.89.2.3/32. Not a CDN: an outer proxy such as
# Cloudflare has to be trusted by the proxy in front, not here.
:3000 {
	# safe defaults for every answer, pages and api alike, unless the app
	# set its own. One directive each: in a single block, one header the app
	# already set would skip all of them.
	header ?X-Frame-Options SAMEORIGIN
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?Permissions-Policy "camera=(), microphone=(), geolocation=()"

	# Reverse proxy for /api
	reverse_proxy /api/* http://localhost:{$BACKEND_PORT:8080} {
		trusted_proxies {$TRUST_PROXY_FROM:private_ranges}
	}

	# Reverse proxy for all other requests
	reverse_proxy /* http://localhost:{$PORT:3333} {
		trusted_proxies {$TRUST_PROXY_FROM:private_ranges}
	}
}
